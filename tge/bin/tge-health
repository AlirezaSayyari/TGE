#!/usr/bin/env bash
set -euo pipefail

ETC_DIR="/opt/v2raytge"
CFG="$ETC_DIR/config.env"
. "$ETC_DIR/tge-lib.sh"
need_root
# shellcheck disable=SC1090
. "$CFG"

GRE_IF="${GRE_IF:-gre-egress}"
TGE_EGRESS_MODE="${TGE_EGRESS_MODE:-v2raya_tun}"
TGE_EDGE_MODE="${TGE_EDGE_MODE:-gre}"
PRIMARY_NIC="${PRIMARY_NIC:-}"
DIRECT_EDGE_GW="${DIRECT_EDGE_GW:-}"
SERVER_GATEWAY="${SERVER_GATEWAY:-}"
SERVER_GATEWAY_IF="${SERVER_GATEWAY_IF:-$PRIMARY_NIC}"
WIREGUARD_IF="${WIREGUARD_IF:-wg0}"
case "$TGE_EDGE_MODE" in
  gre) EDGE_IF="$GRE_IF" ;;
  direct) EDGE_IF="$PRIMARY_NIC" ;;
  *) EDGE_IF="$GRE_IF" ;;
esac
case "$TGE_EGRESS_MODE" in
  wireguard) TUN_IF="${TUN_IF:-$WIREGUARD_IF}" ;;
  server_gateway) TUN_IF="${TUN_IF:-$SERVER_GATEWAY_IF}" ;;
  *) TUN_IF="${TUN_IF:-tun0}" ;;
esac
V2RAY_TABLE="${V2RAY_TABLE:-v2ray}"
V2RAY_TABLE_ID="${V2RAY_TABLE_ID:-100}"
MSS_CLAMP="${MSS_CLAMP:-1436}"
WG_HANDSHAKE_MAX_AGE="${WG_HANDSHAKE_MAX_AGE:-180}"
GRE_SUBNET="10.255.255.0/30"
[[ "$TGE_EDGE_MODE" == "gre" && -n "${GRE_TUN_IP:-}" ]] && GRE_SUBNET="$(cidr_network "$GRE_TUN_IP")"

desired="$(firewall_backend_mode)"
ipt="$(iptables_backend_kind iptables)"
ip6t="$(iptables_backend_kind ip6tables)"

echo "=== TGE Health Check (read-only) ==="
echo "[info] egress mode: $TGE_EGRESS_MODE"
echo "[info] edge mode: $TGE_EDGE_MODE"
echo "[info] edge interface: ${EDGE_IF:-<missing>}"
echo "[info] egress interface: $TUN_IF"
if [[ "$TGE_EGRESS_MODE" == "server_gateway" ]]; then
  echo "[info] server egress gateway: ${SERVER_GATEWAY:-<not set>} via ${SERVER_GATEWAY_IF:-<not set>}"
fi
if [[ "$TGE_EDGE_MODE" == "direct" ]]; then
  echo "[info] direct edge next-hop: ${DIRECT_EDGE_GW:-<not set>}"
fi
echo "[info] desired firewall mode: $desired"
echo "[info] iptables backend: $ipt"
echo "[info] ip6tables backend: $ip6t"
echo
ok=1
chk(){ local n="$1"; shift; if "$@"; then echo "[OK]  $n"; else echo "[BAD] $n"; ok=0; fi; }
rule_has(){ ip -o rule show | grep -qE "$1"; }
link_exists(){ ip link show "$1" >/dev/null 2>&1; }
case "$TGE_EGRESS_MODE" in
  v2raya_tun|wireguard|server_gateway) ;;
  *)
    echo "[BAD] invalid egress mode: $TGE_EGRESS_MODE"
    exit 2
    ;;
esac
wg_recent_handshake(){
  local now
  now="$(date +%s)"
  wg show "$TUN_IF" latest-handshakes 2>/dev/null | awk -v now="$now" -v max_age="$WG_HANDSHAKE_MAX_AGE" '{ if ($2 > 0 && now - $2 <= max_age) ok=1 } END { exit(ok ? 0 : 1) }'
}
wg_allowed_ips_default(){
  wg show "$TUN_IF" allowed-ips 2>/dev/null | grep -qw '0.0.0.0/0'
}
wg_persistent_keepalive(){
  wg show "$TUN_IF" persistent-keepalive 2>/dev/null | awk '$2 > 0 { ok=1 } END { exit(ok ? 0 : 1) }'
}
wg_service_active(){
  systemctl is-active --quiet "wg-quick@${WIREGUARD_IF}"
}
no_stale_tunnel_forward(){
  ! iptables -C FORWARD -i "$EDGE_IF" -o tun0 -j ACCEPT >/dev/null 2>&1 &&
  ! iptables -C FORWARD -i "$EDGE_IF" -o wg0 -j ACCEPT >/dev/null 2>&1
}
gre_params_match(){
  ip -d tunnel show "$GRE_IF" 2>/dev/null | grep -q "remote ${GRE_REMOTE_IP:-} local ${GRE_LOCAL_IP:-}"
}
gre_addr_match(){
  ip -o -4 addr show dev "$GRE_IF" 2>/dev/null | awk '{print $4}' | grep -qx "${GRE_TUN_IP:-}"
}
gre_mtu_match(){
  ip -o link show dev "$GRE_IF" 2>/dev/null | grep -q "mtu ${GRE_MTU:-1476}"
}
stale_singbox_rules_absent(){
  ! ip -o rule show 2>/dev/null | grep -qE '^(9000:|9001:|9002:|9010:).*(lookup 2022|goto 9010|suppress_prefixlength|nop)'
}
server_gateway_policy_rules_absent(){
  ! ip -o rule show 2>/dev/null | grep -qE "^(100:|110:).*lookup (${V2RAY_TABLE}|${V2RAY_TABLE_ID})"
}
server_gateway_table_empty(){
  [[ -z "$(ip route show table "$V2RAY_TABLE" 2>/dev/null)" ]] &&
  [[ -z "$(ip route show table "$V2RAY_TABLE_ID" 2>/dev/null)" ]]
}
server_gateway_main_default_ok(){
  ip route show table main default 2>/dev/null | grep -qE "^default via ${SERVER_GATEWAY//./\\.} dev ${SERVER_GATEWAY_IF}"
}
server_gateway_redirects_disabled(){
  [[ "$(sysctl -n net.ipv4.conf.all.send_redirects 2>/dev/null)" == "0" ]] &&
  [[ "$(sysctl -n "net.ipv4.conf.${SERVER_GATEWAY_IF}.send_redirects" 2>/dev/null)" == "0" ]]
}
server_gateway_probe_nat_ok(){
  iptables -t nat -C POSTROUTING -s "$SERVER_GATEWAY/32" -o "$SERVER_GATEWAY_IF" -j MASQUERADE >/dev/null 2>&1
}
if [[ "$desired" == "legacy" ]]; then
  chk "iptables legacy" bash -lc "iptables --version 2>/dev/null | grep -qi legacy"
else
  echo "[WARN] nft mode is selected (advanced/experimental)."
fi
chk "stale sing-box policy rules absent" stale_singbox_rules_absent
if [[ "$TGE_EDGE_MODE" == "gre" ]]; then
  chk "gre exists" link_exists "$GRE_IF"
  chk "gre local/remote match config" gre_params_match
  chk "gre tunnel address match config" gre_addr_match
  chk "gre MTU match config" gre_mtu_match
else
  chk "primary NIC exists" link_exists "$EDGE_IF"
fi
chk "egress interface exists" link_exists "$TUN_IF"
if [[ "$TGE_EGRESS_MODE" == "wireguard" ]]; then
  chk "WireGuard service active" wg_service_active
  chk "WireGuard recent handshake" wg_recent_handshake
  chk "WireGuard AllowedIPs includes 0.0.0.0/0" wg_allowed_ips_default
  chk "WireGuard PersistentKeepalive enabled" wg_persistent_keepalive
elif [[ "$TGE_EGRESS_MODE" == "server_gateway" ]]; then
  chk "no stale edge->tun0/wg0 FORWARD rules" no_stale_tunnel_forward
fi
if [[ "$TGE_EGRESS_MODE" == "server_gateway" ]]; then
  chk "TGE policy rules absent" server_gateway_policy_rules_absent
  chk "$V2RAY_TABLE table empty" server_gateway_table_empty
  chk "main default via server gateway" server_gateway_main_default_ok
  chk "ICMP redirects disabled" server_gateway_redirects_disabled
  chk "FORWARD edge->server gateway" iptables -C FORWARD -i "$EDGE_IF" -o "$SERVER_GATEWAY_IF" -j ACCEPT
  chk "gateway/SD-WAN probe NAT" server_gateway_probe_nat_ok
else
  chk "rule 100" bash -lc "ip -o rule show | grep -qE '100:.*iif $EDGE_IF.*lookup ($V2RAY_TABLE|$V2RAY_TABLE_ID)' || ip -o rule show | grep -qE 'iif $EDGE_IF.*lookup ($V2RAY_TABLE|$V2RAY_TABLE_ID)'"
  if [[ "$TGE_EDGE_MODE" == "gre" ]]; then
    chk "rule 101" bash -lc "ip -o rule show | grep -qE '101:.*to $GRE_SUBNET.*lookup main' || ip -o rule show | grep -qE 'to $GRE_SUBNET.*lookup main'"
  fi
  chk "rule 110" bash -lc "ip -o rule show | grep -qE '110:.*iif $TUN_IF.*lookup ($V2RAY_TABLE|$V2RAY_TABLE_ID)' || ip -o rule show | grep -qE 'iif $TUN_IF.*lookup ($V2RAY_TABLE|$V2RAY_TABLE_ID)'"
  chk "route default in $V2RAY_TABLE" bash -lc "ip route show table $V2RAY_TABLE | grep -qE \"^default dev $TUN_IF\" || ip route show table $V2RAY_TABLE_ID | grep -qE \"^default dev $TUN_IF\""
  chk "FORWARD edge->egress" iptables -C FORWARD -i "$EDGE_IF" -o "$TUN_IF" -j ACCEPT
  chk "FORWARD egress->edge established" iptables -C FORWARD -i "$TUN_IF" -o "$EDGE_IF" -m conntrack --ctstate RELATED,ESTABLISHED -j ACCEPT
fi
if [[ -n "${LAN_CIDRS:-}" ]]; then
  for cidr in $(echo "$LAN_CIDRS" | tr "," " "); do
    if [[ "$TGE_EGRESS_MODE" == "server_gateway" ]]; then
      echo "[OK]  $cidr returns through main default route"
    elif [[ "$TGE_EDGE_MODE" == "direct" && -n "$DIRECT_EDGE_GW" ]]; then
      if ip route show table "$V2RAY_TABLE" "$cidr" 2>/dev/null | grep -qE "^${cidr//\//\\/} via ${DIRECT_EDGE_GW//./\\.} dev ${EDGE_IF}"; then
        echo "[OK]  route $cidr via $DIRECT_EDGE_GW dev $EDGE_IF in $V2RAY_TABLE"
      else
        echo "[BAD] route $cidr via $DIRECT_EDGE_GW dev $EDGE_IF in $V2RAY_TABLE"
        ok=0
      fi
    else
      if ip route show table "$V2RAY_TABLE" "$cidr" 2>/dev/null | grep -qE "^${cidr//\//\\/} dev ${EDGE_IF}"; then
        echo "[OK]  route $cidr dev $EDGE_IF in $V2RAY_TABLE"
      else
        echo "[BAD] route $cidr dev $EDGE_IF in $V2RAY_TABLE"
        ok=0
      fi
    fi
    if [[ "$TGE_EGRESS_MODE" == "server_gateway" ]]; then
      if iptables -t nat -C POSTROUTING -s "$cidr" -o "$TUN_IF" -j MASQUERADE >/dev/null 2>&1; then
        echo "[OK]  NAT $cidr -> server gateway ($TUN_IF)"
      else
        echo "[BAD] NAT $cidr -> server gateway ($TUN_IF)"
        ok=0
      fi
    elif iptables -t nat -C POSTROUTING -s "$cidr" -o "$TUN_IF" -j MASQUERADE >/dev/null 2>&1; then
      echo "[OK]  NAT $cidr -> $TUN_IF"
    else
      echo "[BAD] NAT $cidr -> $TUN_IF"
      ok=0
    fi
  done
else
  echo "[WARN] LAN_CIDRS is empty in config."
fi
if [[ "$TGE_EGRESS_MODE" == "server_gateway" ]]; then
  echo "[OK]  tunnel MSS rules skipped in server_gateway mode"
elif [[ "$TGE_EDGE_MODE" == "gre" ]]; then
  chk "MSS clamp" iptables -t mangle -C FORWARD -i "$GRE_IF" -o "$TUN_IF" -p tcp --tcp-flags SYN,RST SYN -j TCPMSS --set-mss "$MSS_CLAMP"
else
  echo "[OK]  MSS clamp skipped in direct mode"
fi
echo
if [[ "$ok" -eq 1 ]]; then
  echo "✅ HEALTH: OK"
  exit 0
else
  echo "❌ HEALTH: Issues detected"
  exit 1
fi
