#!/usr/bin/env bash
set -euo pipefail

ETC_DIR="/opt/v2raytge"
CFG="$ETC_DIR/config.env"
LOG_DIR="/var/log/v2raytge"
mkdir -p "$LOG_DIR"

# Load shared helpers (installed to /opt/v2raytge/tge-lib.sh by deploy.sh)
. "$ETC_DIR/tge-lib.sh"

need_root

if ! firewall_backend_preflight; then
  echo "[tge-apply] Refusing to continue due to firewall backend preflight failure." >&2
  exit 40
fi


if [[ ! -f "$CFG" ]]; then
  echo "[tge-apply] ERROR: config not found: $CFG"
  echo "[tge-apply] Run: sudo tge  ->  Config Egress System"
  exit 1
fi

# shellcheck disable=SC1090
. "$CFG"

log(){ echo "[tge-apply] $*"; }

# Defaults (if config doesn't contain them for any reason)
GRE_IF="${GRE_IF:-gre-egress}"
TGE_EDGE_MODE="${TGE_EDGE_MODE:-gre}"
PRIMARY_NIC="${PRIMARY_NIC:-}"
TUN_IF="${TUN_IF:-tun0}"
V2RAY_TABLE="${V2RAY_TABLE:-v2ray}"
V2RAY_TABLE_ID="${V2RAY_TABLE_ID:-100}"
MSS_CLAMP="${MSS_CLAMP:-1436}"
GRE_MTU="${GRE_MTU:-1476}"
case "$TGE_EDGE_MODE" in
  gre) EDGE_IF="$GRE_IF" ;;
  direct)
    EDGE_IF="$PRIMARY_NIC"
    [[ -n "$EDGE_IF" ]] || { log "ERROR: PRIMARY_NIC is required in direct mode."; exit 2; }
    ;;
  *)
    log "ERROR: invalid TGE_EDGE_MODE=$TGE_EDGE_MODE (use: gre|direct)."
    exit 2
    ;;
esac

# Derive GRE subnet from configured tunnel CIDR (e.g. 10.255.255.6/30 -> 10.255.255.4/30)
if [[ "$TGE_EDGE_MODE" == "gre" && -n "${GRE_TUN_IP:-}" ]]; then
  GRE_SUBNET="$(cidr_network "$GRE_TUN_IP")"
elif [[ "$TGE_EDGE_MODE" == "gre" ]]; then
  GRE_SUBNET="10.255.255.0/30"
  log "WARN: GRE_TUN_IP missing; fallback GRE_SUBNET=$GRE_SUBNET"
fi
if [[ "$TGE_EDGE_MODE" == "gre" ]]; then
  GRE_SUBNET_RE="${GRE_SUBNET//./\\.}"
  GRE_SUBNET_RE="${GRE_SUBNET_RE//\//\\/}"
fi

# 0) Quick wait: avoid boot flaps; but never hard-fail (no start-limit storms)
for _ in $(seq 1 30); do
  ip link show "$EDGE_IF" >/dev/null 2>&1 || { sleep 1; continue; }
  ip link show "$TUN_IF" >/dev/null 2>&1 || { sleep 1; continue; }
  break
done

if ! ip link show "$EDGE_IF" >/dev/null 2>&1; then
  log "WARN: $EDGE_IF missing; exit 0 (no change)."
  exit 0
fi

if ! ip link show "$TUN_IF" >/dev/null 2>&1; then
  log "WARN: $TUN_IF missing (v2rayA not ready); exit 0 (no change)."
  exit 0
fi

# 1) sysctl (safe re-apply)
sysctl -w net.ipv4.ip_forward=1 >/dev/null
sysctl -w net.ipv4.conf.all.rp_filter=0 >/dev/null
sysctl -w net.ipv4.conf.default.rp_filter=0 >/dev/null
sysctl -w "net.ipv4.conf.${EDGE_IF}.rp_filter=0" >/dev/null || true
sysctl -w "net.ipv4.conf.${TUN_IF}.rp_filter=0"  >/dev/null || true

# 2) rt_tables ensure (append-only if missing)
ensure_rt_table "$V2RAY_TABLE_ID" "$V2RAY_TABLE"

# 3) Routes in v2ray table (safe replace; DOES NOT touch main default route)
ip route replace default dev "$TUN_IF" table "$V2RAY_TABLE"

# LAN CIDRs (comma separated)
if [[ -n "${LAN_CIDRS:-}" ]]; then
  for cidr in $(echo "$LAN_CIDRS" | tr ',' ' '); do
    ip route replace "$cidr" dev "$EDGE_IF" table "$V2RAY_TABLE"
  done
else
  log "WARN: LAN_CIDRS empty; routing table may be incomplete."
fi

# 4) Policy rules: ensure our prefs exist; do not modify if pref exists but differs
rule100_line="$(ip -o rule show 2>/dev/null | awk '$1=="100:"{print; exit}')"
if [[ -n "$rule100_line" ]] \
  && ! echo "$rule100_line" | grep -qE "iif ${EDGE_IF} .*lookup (${V2RAY_TABLE}|${V2RAY_TABLE_ID})" \
  && echo "$rule100_line" | grep -qE "lookup (${V2RAY_TABLE}|${V2RAY_TABLE_ID})"; then
  log "INFO: pref 100 belongs to TGE but targets a different edge interface; replacing. line=[$rule100_line]"
  ip rule del pref 100 || true
fi
ensure_rule_pref 100 "iif ${EDGE_IF} .*lookup (${V2RAY_TABLE}|${V2RAY_TABLE_ID})" \
  ip rule add pref 100 iif "$EDGE_IF" lookup "$V2RAY_TABLE"

if [[ "$TGE_EDGE_MODE" == "gre" ]]; then
  rule101_line="$(ip -o rule show 2>/dev/null | awk '$1=="101:"{print; exit}')"
  if [[ -n "$rule101_line" ]] && ! echo "$rule101_line" | grep -qE "to ${GRE_SUBNET_RE} .*lookup main"; then
    log "INFO: pref 101 exists with different subnet; replacing. line=[$rule101_line]"
    ip rule del pref 101 || true
  fi

  # Stability helper: keep GRE subnet route lookups in main table.
  ensure_rule_pref 101 "to ${GRE_SUBNET_RE} .*lookup main" \
    ip rule add pref 101 to "$GRE_SUBNET" lookup main
fi

ensure_rule_pref 110 "iif ${TUN_IF} .*lookup (${V2RAY_TABLE}|${V2RAY_TABLE_ID})" \
  ip rule add pref 110 iif "$TUN_IF" lookup "$V2RAY_TABLE"

ip route flush cache || true

# 5) iptables ensure-only (NO flush, NO policy change)

# NAT: MASQUERADE each LAN CIDR out of tun0
if [[ -n "${LAN_CIDRS:-}" ]]; then
  for cidr in $(echo "$LAN_CIDRS" | tr ',' ' '); do
    iptables_ensure nat POSTROUTING "-s $cidr -o $TUN_IF -j MASQUERADE"
  done
fi

# FORWARD allow edge->tun and return established
iptables_ensure filter FORWARD "-i $EDGE_IF -o $TUN_IF -j ACCEPT"
iptables_ensure filter FORWARD "-i $TUN_IF -o $EDGE_IF -m conntrack --ctstate RELATED,ESTABLISHED -j ACCEPT"

# MSS Clamp critical fix for GRE only; direct mode keeps native interface MTU/MSS.
if [[ "$TGE_EDGE_MODE" == "gre" ]]; then
  iptables_ensure_mangle_insert_first "$GRE_IF" "$TUN_IF" "$MSS_CLAMP"
fi

# Keep generic clamps (ensure only)
iptables_ensure mangle FORWARD "-o $TUN_IF -p tcp --tcp-flags SYN,RST SYN -j TCPMSS --clamp-mss-to-pmtu"
if [[ "$TGE_EDGE_MODE" == "gre" ]]; then
  iptables_ensure mangle FORWARD "-o $GRE_IF -p tcp --tcp-flags SYN,RST SYN -j TCPMSS --clamp-mss-to-pmtu"
fi

log "OK: ensured."
