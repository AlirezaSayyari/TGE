#!/usr/bin/env bash
set -euo pipefail

ETC_DIR="/opt/v2raytge"
CFG="$ETC_DIR/config.env"
LOG_DIR="/var/log/v2raytge"
mkdir -p "$LOG_DIR"

# Load shared helpers (installed to /opt/v2raytge/tge-lib.sh by deploy.sh)
. "$ETC_DIR/tge-lib.sh"

need_root

if ! firewall_backend_preflight; then
  echo "[tge-apply] Refusing to continue due to firewall backend preflight failure." >&2
  exit 40
fi


if [[ ! -f "$CFG" ]]; then
  echo "[tge-apply] ERROR: config not found: $CFG"
  echo "[tge-apply] Run: sudo tge  ->  Config Egress System"
  exit 1
fi

# shellcheck disable=SC1090
. "$CFG"

log(){ echo "[tge-apply] $*"; }

# Defaults (if config doesn't contain them for any reason)
GRE_IF="${GRE_IF:-gre-egress}"
TGE_EGRESS_MODE="${TGE_EGRESS_MODE:-v2raya_tun}"
TGE_EDGE_MODE="${TGE_EDGE_MODE:-gre}"
PRIMARY_NIC="${PRIMARY_NIC:-}"
DIRECT_EDGE_GW="${DIRECT_EDGE_GW:-}"
SERVER_GATEWAY="${SERVER_GATEWAY:-}"
SERVER_GATEWAY_IF="${SERVER_GATEWAY_IF:-$PRIMARY_NIC}"
WIREGUARD_IF="${WIREGUARD_IF:-wg0}"
case "$TGE_EGRESS_MODE" in
  wireguard) TUN_IF="${TUN_IF:-$WIREGUARD_IF}" ;;
  server_gateway) TUN_IF="${TUN_IF:-$SERVER_GATEWAY_IF}" ;;
  *) TUN_IF="${TUN_IF:-tun0}" ;;
esac
V2RAY_TABLE="${V2RAY_TABLE:-v2ray}"
V2RAY_TABLE_ID="${V2RAY_TABLE_ID:-100}"
MSS_CLAMP="${MSS_CLAMP:-1436}"
GRE_MTU="${GRE_MTU:-1476}"
WG_HANDSHAKE_MAX_AGE="${WG_HANDSHAKE_MAX_AGE:-180}"
WG_RESTART_COOLDOWN="${WG_RESTART_COOLDOWN:-300}"
case "$TGE_EDGE_MODE" in
  gre) EDGE_IF="$GRE_IF" ;;
  direct)
    EDGE_IF="$PRIMARY_NIC"
    [[ -n "$EDGE_IF" ]] || { log "ERROR: PRIMARY_NIC is required in direct mode."; exit 2; }
    ;;
  *)
    log "ERROR: invalid TGE_EDGE_MODE=$TGE_EDGE_MODE (use: gre|direct)."
    exit 2
    ;;
esac
case "$TGE_EGRESS_MODE" in
  v2raya_tun|wireguard|server_gateway) ;;
  *)
    log "ERROR: invalid TGE_EGRESS_MODE=$TGE_EGRESS_MODE (use: v2raya_tun|wireguard|server_gateway)."
    exit 2
    ;;
esac

default_gateway_for_iface(){
  local iface="$1" gw
  gw="$(ip route show default dev "$iface" 2>/dev/null | awk '/default/ {for(i=1;i<=NF;i++) if($i=="via") print $(i+1)}' | head -n1)"
  if [[ -z "$gw" ]]; then
    gw="$(ip route show default 2>/dev/null | awk '/default/ {for(i=1;i<=NF;i++) if($i=="via") print $(i+1)}' | head -n1)"
  fi
  echo "$gw"
}

if [[ "$TGE_EGRESS_MODE" == "server_gateway" ]]; then
  [[ -n "$SERVER_GATEWAY_IF" ]] || SERVER_GATEWAY_IF="$(guess_primary_nic)"
  [[ -n "$SERVER_GATEWAY_IF" ]] || { log "ERROR: SERVER_GATEWAY_IF is required in server_gateway mode."; exit 2; }
  TUN_IF="$SERVER_GATEWAY_IF"
  SERVER_GATEWAY="${SERVER_GATEWAY:-$(default_gateway_for_iface "$SERVER_GATEWAY_IF")}"
  [[ -n "$SERVER_GATEWAY" ]] || { log "ERROR: SERVER_GATEWAY is required in server_gateway mode."; exit 2; }
fi

wireguard_runtime_allowedips_ok(){
  wg show "$TUN_IF" allowed-ips 2>/dev/null | grep -qw '0.0.0.0/0'
}

wireguard_recent_handshake_ok(){
  local now
  now="$(date +%s)"
  wg show "$TUN_IF" latest-handshakes 2>/dev/null | awk -v now="$now" -v max_age="$WG_HANDSHAKE_MAX_AGE" '
    $2 > 0 && now - $2 <= max_age { ok=1 }
    END { exit(ok ? 0 : 1) }
  '
}

wireguard_restart_allowed(){
  local stamp_dir="/run/v2raytge" stamp_file now last=0
  stamp_file="${stamp_dir}/wg-${WIREGUARD_IF}.restart"
  now="$(date +%s)"
  mkdir -p "$stamp_dir"
  [[ -r "$stamp_file" ]] && read -r last < "$stamp_file" || true
  if (( now - last < WG_RESTART_COOLDOWN )); then
    return 1
  fi
  printf '%s\n' "$now" > "$stamp_file"
  return 0
}

ensure_wireguard_gateway_config(){
  [[ "$TGE_EGRESS_MODE" == "wireguard" ]] || return 0
  local conf="/etc/wireguard/${WIREGUARD_IF}.conf" tmp changed=0 needs_restart=0
  if [[ ! -f "$conf" ]]; then
    log "WARN: WireGuard config not found: $conf"
    return 0
  fi

  tmp="$(mktemp)"
  python3 - "$conf" "$tmp" <<'PY'
import sys
src, dst = sys.argv[1], sys.argv[2]
lines = open(src, encoding="utf-8").read().splitlines()
out = []
in_interface = False
in_peer = False
interface_seen = False
table_seen = False
ipv4_address_seen = False
peer_seen = False
peer_allowedips_seen = False
peer_keepalive_seen = False

def close_section():
    global table_seen, peer_allowedips_seen, peer_keepalive_seen
    if in_interface and not table_seen:
        out.append("Table = off")
    if in_peer and not peer_allowedips_seen:
        out.append("AllowedIPs = 0.0.0.0/0")
    if in_peer and not peer_keepalive_seen:
        out.append("PersistentKeepalive = 25")

for line in lines:
    stripped = line.strip()
    lower = stripped.lower()
    if stripped.startswith("[") and stripped.endswith("]"):
        close_section()
        in_interface = lower == "[interface]"
        in_peer = lower == "[peer]"
        if in_interface:
            interface_seen = True
            table_seen = False
        if in_peer:
            peer_seen = True
            peer_allowedips_seen = False
            peer_keepalive_seen = False
        out.append(line)
        continue
    if in_interface:
        if lower.startswith("table"):
            out.append("Table = off")
            table_seen = True
            continue
        if lower.startswith("dns"):
            continue
        if lower.startswith("address"):
            key, sep, value = line.partition("=")
            if sep:
                ipv4 = [part.strip() for part in value.split(",") if ":" not in part and part.strip()]
                if ipv4:
                    ipv4_address_seen = True
                    out.append(f"{key.strip()} = {', '.join(ipv4)}")
                continue
    if in_peer and lower.startswith("allowedips"):
        out.append("AllowedIPs = 0.0.0.0/0")
        peer_allowedips_seen = True
        continue
    if in_peer and lower.startswith("persistentkeepalive"):
        out.append("PersistentKeepalive = 25")
        peer_keepalive_seen = True
        continue
    out.append(line)

close_section()
if not interface_seen:
    raise SystemExit("ERROR: WireGuard config has no [Interface] section")
if not ipv4_address_seen:
    raise SystemExit("ERROR: WireGuard config has no IPv4 Address in [Interface]")
if not peer_seen:
    raise SystemExit("ERROR: WireGuard config has no [Peer] section")
open(dst, "w", encoding="utf-8").write("\n".join(out) + "\n")
PY

  if ! cmp -s "$conf" "$tmp"; then
    install -m 600 "$tmp" "$conf"
    changed=1
    needs_restart=1
    log "INFO: healed WireGuard config for gateway mode: $conf"
  fi
  rm -f "$tmp"

  if ip link show "$TUN_IF" >/dev/null 2>&1; then
    if ! wireguard_runtime_allowedips_ok; then
      needs_restart=1
      log "INFO: WireGuard runtime is missing AllowedIPs 0.0.0.0/0; restarting wg-quick@${WIREGUARD_IF}."
    elif ! wireguard_recent_handshake_ok; then
      if wireguard_restart_allowed; then
        needs_restart=1
        log "INFO: WireGuard handshake is stale; restarting wg-quick@${WIREGUARD_IF}."
      else
        log "WARN: WireGuard handshake is stale; restart skipped due to cooldown (${WG_RESTART_COOLDOWN}s)."
      fi
    fi
  else
    needs_restart=1
    log "INFO: WireGuard interface $TUN_IF is missing; starting wg-quick@${WIREGUARD_IF}."
  fi

  if [[ "$needs_restart" -eq 1 ]]; then
    if [[ "$changed" -eq 1 ]] || ip link show "$TUN_IF" >/dev/null 2>&1; then
      systemctl restart "wg-quick@${WIREGUARD_IF}" || log "WARN: failed to restart wg-quick@${WIREGUARD_IF}."
    else
      systemctl start "wg-quick@${WIREGUARD_IF}" || log "WARN: failed to start wg-quick@${WIREGUARD_IF}."
    fi
  fi
}

ensure_wireguard_gateway_config

# Derive GRE subnet from configured tunnel CIDR (e.g. 10.255.255.6/30 -> 10.255.255.4/30)
if [[ "$TGE_EDGE_MODE" == "gre" && -n "${GRE_TUN_IP:-}" ]]; then
  GRE_SUBNET="$(cidr_network "$GRE_TUN_IP")"
elif [[ "$TGE_EDGE_MODE" == "gre" ]]; then
  GRE_SUBNET="10.255.255.0/30"
  log "WARN: GRE_TUN_IP missing; fallback GRE_SUBNET=$GRE_SUBNET"
fi
if [[ "$TGE_EDGE_MODE" == "gre" ]]; then
  GRE_SUBNET_RE="${GRE_SUBNET//./\\.}"
  GRE_SUBNET_RE="${GRE_SUBNET_RE//\//\\/}"
fi

# 0) Quick wait: avoid boot flaps; but never hard-fail (no start-limit storms)
for _ in $(seq 1 30); do
  ip link show "$EDGE_IF" >/dev/null 2>&1 || { sleep 1; continue; }
  ip link show "$TUN_IF" >/dev/null 2>&1 || { sleep 1; continue; }
  break
done

if ! ip link show "$EDGE_IF" >/dev/null 2>&1; then
  log "WARN: $EDGE_IF missing; exit 0 (no change)."
  exit 0
fi

if ! ip link show "$TUN_IF" >/dev/null 2>&1; then
  log "WARN: $TUN_IF missing; exit 0 (no change)."
  exit 0
fi

# 1) sysctl (safe re-apply)
sysctl -w net.ipv4.ip_forward=1 >/dev/null
sysctl -w net.ipv4.conf.all.rp_filter=0 >/dev/null
sysctl -w net.ipv4.conf.default.rp_filter=0 >/dev/null
sysctl -w "net.ipv4.conf.${EDGE_IF}.rp_filter=0" >/dev/null || true
sysctl -w "net.ipv4.conf.${TUN_IF}.rp_filter=0"  >/dev/null || true

delete_rule_pref_if_matching(){
  local pref="$1" regex="$2" line
  while true; do
    line="$(ip -o rule show 2>/dev/null | awk -v p="${pref}:" '$1==p{print; exit}')"
    [[ -n "$line" ]] || return 0
    echo "$line" | grep -qE "$regex" || return 0
    ip rule del pref "$pref" || true
  done
}

cleanup_stale_singbox_rules(){
  local found=0
  if ip -o rule show 2>/dev/null | grep -qE '^(9000:|9001:|9002:|9010:).*(lookup 2022|goto 9010|suppress_prefixlength|nop)'; then
    found=1
  fi
  delete_rule_pref_if_matching 9000 'lookup 2022'
  delete_rule_pref_if_matching 9001 'goto 9010'
  delete_rule_pref_if_matching 9002 '(lookup 2022|lookup main suppress_prefixlength|suppress_prefixlength)'
  delete_rule_pref_if_matching 9010 'nop'
  ip route flush table 2022 >/dev/null 2>&1 || true
  [[ "$found" -eq 0 ]] || log "INFO: removed stale sing-box policy rules/table 2022."
}

delete_mangle_rule(){
  while iptables -t mangle -D FORWARD "$@" 2>/dev/null; do :; done
}

cleanup_stale_egress_if(){
  local old_if="$1" cidr
  [[ "$old_if" != "$TUN_IF" ]] || return 0
  safe_ip_rule_del 110 "iif $old_if lookup $V2RAY_TABLE"
  safe_ip_rule_del 110 "iif $old_if lookup $V2RAY_TABLE_ID"
  safe_iptables_del_forward "$EDGE_IF" "$old_if" || true
  if [[ -n "${LAN_CIDRS:-}" ]]; then
    for cidr in $(echo "$LAN_CIDRS" | tr ',' ' '); do
      safe_iptables_del_nat "$cidr" "$old_if" || true
    done
  fi
  if [[ "$TGE_EDGE_MODE" == "gre" ]]; then
    delete_mangle_rule -i "$GRE_IF" -o "$old_if" -p tcp --tcp-flags SYN,RST SYN -j TCPMSS --set-mss "$MSS_CLAMP"
  fi
  delete_mangle_rule -o "$old_if" -p tcp --tcp-flags SYN,RST SYN -j TCPMSS --clamp-mss-to-pmtu
}

# Clean leftovers from experimental sing-box TUN tests and from previous
# egress interfaces when switching between v2rayA tun0 and WireGuard wg0.
# This is targeted and does not flush chains, default routes, or direct mode
# next-hop routes.
cleanup_stale_singbox_rules
cleanup_stale_egress_if "tun0"
cleanup_stale_egress_if "wg0"

# 2) rt_tables ensure (append-only if missing)
ensure_rt_table "$V2RAY_TABLE_ID" "$V2RAY_TABLE"

# 3) Routes in v2ray table (safe replace; DOES NOT touch main default route)
if [[ "$TGE_EGRESS_MODE" == "server_gateway" ]]; then
  ip route replace default via "$SERVER_GATEWAY" dev "$SERVER_GATEWAY_IF" table "$V2RAY_TABLE"
else
  ip route replace default dev "$TUN_IF" table "$V2RAY_TABLE"
fi

# LAN CIDRs (comma separated)
if [[ -n "${LAN_CIDRS:-}" ]]; then
  for cidr in $(echo "$LAN_CIDRS" | tr ',' ' '); do
    if [[ "$TGE_EDGE_MODE" == "direct" && -n "$DIRECT_EDGE_GW" ]]; then
      ip route replace "$cidr" via "$DIRECT_EDGE_GW" dev "$EDGE_IF" table "$V2RAY_TABLE"
    else
      if [[ "$TGE_EDGE_MODE" == "direct" ]]; then
        log "WARN: DIRECT_EDGE_GW is empty; routing $cidr as directly connected on $EDGE_IF."
      fi
      ip route replace "$cidr" dev "$EDGE_IF" table "$V2RAY_TABLE"
    fi
  done
else
  log "WARN: LAN_CIDRS empty; routing table may be incomplete."
fi

# 4) Policy rules: ensure our prefs exist; do not modify if pref exists but differs
rule100_line="$(ip -o rule show 2>/dev/null | awk '$1=="100:"{print; exit}')"
if [[ -n "$rule100_line" ]] \
  && ! echo "$rule100_line" | grep -qE "iif ${EDGE_IF} .*lookup (${V2RAY_TABLE}|${V2RAY_TABLE_ID})" \
  && echo "$rule100_line" | grep -qE "lookup (${V2RAY_TABLE}|${V2RAY_TABLE_ID})"; then
  log "INFO: pref 100 belongs to TGE but targets a different edge interface; replacing. line=[$rule100_line]"
  ip rule del pref 100 || true
fi
ensure_rule_pref 100 "iif ${EDGE_IF} .*lookup (${V2RAY_TABLE}|${V2RAY_TABLE_ID})" \
  ip rule add pref 100 iif "$EDGE_IF" lookup "$V2RAY_TABLE"

if [[ "$TGE_EDGE_MODE" == "gre" ]]; then
  rule101_line="$(ip -o rule show 2>/dev/null | awk '$1=="101:"{print; exit}')"
  if [[ -n "$rule101_line" ]] && ! echo "$rule101_line" | grep -qE "to ${GRE_SUBNET_RE} .*lookup main"; then
    log "INFO: pref 101 exists with different subnet; replacing. line=[$rule101_line]"
    ip rule del pref 101 || true
  fi

  # Stability helper: keep GRE subnet route lookups in main table.
  ensure_rule_pref 101 "to ${GRE_SUBNET_RE} .*lookup main" \
    ip rule add pref 101 to "$GRE_SUBNET" lookup main
fi

if [[ "$TGE_EGRESS_MODE" == "server_gateway" && "$TUN_IF" == "$EDGE_IF" ]]; then
  safe_ip_rule_del 110 "iif tun0 lookup $V2RAY_TABLE"
  safe_ip_rule_del 110 "iif tun0 lookup $V2RAY_TABLE_ID"
  safe_ip_rule_del 110 "iif wg0 lookup $V2RAY_TABLE"
  safe_ip_rule_del 110 "iif wg0 lookup $V2RAY_TABLE_ID"
else
  rule110_line="$(ip -o rule show 2>/dev/null | awk '$1=="110:"{print; exit}')"
  if [[ -n "$rule110_line" ]] \
    && ! echo "$rule110_line" | grep -qE "iif ${TUN_IF} .*lookup (${V2RAY_TABLE}|${V2RAY_TABLE_ID})" \
    && echo "$rule110_line" | grep -qE "lookup (${V2RAY_TABLE}|${V2RAY_TABLE_ID})"; then
    log "INFO: pref 110 belongs to TGE but targets a different egress interface; replacing. line=[$rule110_line]"
    ip rule del pref 110 || true
  fi
  ensure_rule_pref 110 "iif ${TUN_IF} .*lookup (${V2RAY_TABLE}|${V2RAY_TABLE_ID})" \
    ip rule add pref 110 iif "$TUN_IF" lookup "$V2RAY_TABLE"
fi

ip route flush cache || true

# 5) iptables ensure-only (NO flush, NO policy change)

# NAT: MASQUERADE each LAN CIDR out of tunnel egress only. In server_gateway
# mode, NAT is intentionally left to the edge device such as FortiGate.
if [[ "$TGE_EGRESS_MODE" != "server_gateway" && -n "${LAN_CIDRS:-}" ]]; then
  for cidr in $(echo "$LAN_CIDRS" | tr ',' ' '); do
    iptables_ensure nat POSTROUTING "-s $cidr -o $TUN_IF -j MASQUERADE"
  done
fi

# FORWARD allow edge->egress and return established
iptables_ensure filter FORWARD "-i $EDGE_IF -o $TUN_IF -j ACCEPT"
iptables_ensure filter FORWARD "-i $TUN_IF -o $EDGE_IF -m conntrack --ctstate RELATED,ESTABLISHED -j ACCEPT"

# MSS Clamp critical fix for GRE only; direct mode keeps native interface MTU/MSS.
if [[ "$TGE_EDGE_MODE" == "gre" ]]; then
  iptables_ensure_mangle_insert_first "$GRE_IF" "$TUN_IF" "$MSS_CLAMP"
fi

# Keep generic clamps (ensure only)
iptables_ensure mangle FORWARD "-o $TUN_IF -p tcp --tcp-flags SYN,RST SYN -j TCPMSS --clamp-mss-to-pmtu"
if [[ "$TGE_EDGE_MODE" == "gre" ]]; then
  iptables_ensure mangle FORWARD "-o $GRE_IF -p tcp --tcp-flags SYN,RST SYN -j TCPMSS --clamp-mss-to-pmtu"
fi

log "OK: ensured."
