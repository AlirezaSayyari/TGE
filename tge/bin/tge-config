#!/usr/bin/env bash
set -euo pipefail

ETC_DIR="/opt/v2raytge"
CFG="$ETC_DIR/config.env"
META_FILE="$ETC_DIR/meta.env"
mkdir -p "$ETC_DIR"

. "$ETC_DIR/tge-lib.sh"

if [[ -r "$META_FILE" ]]; then
  # shellcheck disable=SC1090
  . "$META_FILE"
fi

need_root
default_egress_mode="${TGE_EGRESS_MODE:-v2raya_tun}"; default_edge_mode="${TGE_EDGE_MODE:-gre}"; default_direct_edge_gw="${DIRECT_EDGE_GW:-}"; default_server_gateway="${SERVER_GATEWAY:-}"; default_server_gateway_if="${SERVER_GATEWAY_IF:-}"; default_gre_remote_ip="${GRE_REMOTE_IP:-}"; default_gre_tun_ip="${GRE_TUN_IP:-10.255.255.2/30}"; default_lan_cidr="${LAN_CIDRS:-192.168.0.0/16}"; default_gre_mtu="${GRE_MTU:-1476}"; default_mss="${MSS_CLAMP:-1436}"; default_gui_port="${V2RAYA_GUI_PORT:-2017}"; default_wg_if="${WIREGUARD_IF:-wg0}"

preview_nic="$(guess_primary_nic)"
[[ -n "$preview_nic" ]] || preview_nic="eth0"
preview_ip="$(iface_ipv4 "$preview_nic" || true)"
[[ -n "$preview_ip" ]] || preview_ip="<VM_IP>"

tun0_precheck_or_guide(){
  if ip link show tun0 >/dev/null 2>&1; then
    echo "[wizard] tun0 is already present."
    return 0
  fi

  echo
  echo "[wizard] Step 0: tun0 is not present yet."
  echo "Please complete v2rayA setup, then come back here."
  echo "- open V2rayA GUI (http://${preview_ip}:${default_gui_port})"
  echo "- Import Connection Config/Subscription"
  echo "- From Right-Above Dashboard Click Setting"
  echo "- Set Transparent Proxy/System Proxy --> On: Do Not Split Traffic"
  echo "- Set Transpatent Proxy/System Proxy Implementation --> system tun"
  echo "- Set Prevent DNS Spoofing --> Forward DNS Request"
  echo "- (optional) Set Automatically Update Subscriptions --> Update When Service Start"
  echo "- Click On Save and Apply"
  echo "- In Dashboard Click On [Select] Button of Desire Connection"
  echo "- From Left-Above Dashboard Click On Ready/Start Button"
  echo "- then came back to server cli and continue setup wizard"
  echo

  while true; do
    local act
    read -r -p "Type 'check' to re-check tun0, or 'skip' to continue anyway [check/skip]: " act
    act="${act:-check}"
    case "$act" in
      check|CHECK)
        if ip link show tun0 >/dev/null 2>&1; then
          echo "[wizard] tun0 detected. Continue."
          return 0
        fi
        echo "[wizard] tun0 still missing. Complete v2rayA steps and try again."
        ;;
      skip|SKIP)
        echo "[wizard][WARN] continuing while tun0 is missing."
        return 0
        ;;
      *)
        echo "[wizard] invalid choice. use: check or skip"
        ;;
    esac
  done
}

choose_number(){
  local prompt="$1" default_choice="$2" choice max
  shift 2
  max="$#"
  echo "$prompt" >&2
  local i=1
  for item in "$@"; do
    echo "  $i) $item" >&2
    i=$((i+1))
  done
  while true; do
    read -r -p "Select [${default_choice}]: " choice >&2
    choice="${choice:-$default_choice}"
    if [[ "$choice" =~ ^[0-9]+$ ]] && (( choice >= 1 && choice <= max )); then
      echo "$choice"
      return 0
    fi
    echo "ERROR: invalid choice. enter a number between 1 and $max." >&2
  done
}

validate_ifname(){
  local name="$1"
  [[ "$name" =~ ^[a-zA-Z0-9_.:-]{1,15}$ ]] || { echo "ERROR: invalid interface name: $name"; exit 1; }
}

normalize_wireguard_config(){
  local src="$1" dst="$2"
  python3 - "$src" "$dst" <<'PY'
import sys
src, dst = sys.argv[1], sys.argv[2]
lines = open(src, encoding="utf-8").read().splitlines()
out = []
in_interface = False
in_peer = False
interface_seen = False
table_seen = False
ipv4_address_seen = False
peer_seen = False
peer_allowedips_seen = False
peer_keepalive_seen = False
for line in lines:
    stripped = line.strip()
    lower = stripped.lower()
    if stripped.startswith("[") and stripped.endswith("]"):
        if in_interface and not table_seen:
            out.append("Table = off")
        if in_peer and not peer_allowedips_seen:
            out.append("AllowedIPs = 0.0.0.0/0")
        if in_peer and not peer_keepalive_seen:
            out.append("PersistentKeepalive = 25")
        in_interface = lower == "[interface]"
        in_peer = lower == "[peer]"
        if in_interface:
            interface_seen = True
            table_seen = False
        if in_peer:
            peer_seen = True
            peer_allowedips_seen = False
            peer_keepalive_seen = False
        out.append(line)
        continue
    if in_interface:
        if lower.startswith("table"):
            out.append("Table = off")
            table_seen = True
            continue
        if lower.startswith("dns"):
            continue
        if lower.startswith("address"):
            key, sep, value = line.partition("=")
            if sep:
                ipv4 = [part.strip() for part in value.split(",") if ":" not in part and part.strip()]
                if ipv4:
                    ipv4_address_seen = True
                    out.append(f"{key.strip()} = {', '.join(ipv4)}")
                    continue
                continue
    if in_peer and lower.startswith("allowedips"):
        out.append("AllowedIPs = 0.0.0.0/0")
        peer_allowedips_seen = True
        continue
    if in_peer and lower.startswith("persistentkeepalive"):
        out.append("PersistentKeepalive = 25")
        peer_keepalive_seen = True
        continue
    out.append(line)
if in_interface and not table_seen:
    out.append("Table = off")
if in_peer and not peer_allowedips_seen:
    out.append("AllowedIPs = 0.0.0.0/0")
if in_peer and not peer_keepalive_seen:
    out.append("PersistentKeepalive = 25")
if not interface_seen:
    raise SystemExit("ERROR: WireGuard config has no [Interface] section")
if not ipv4_address_seen:
    raise SystemExit("ERROR: WireGuard config has no IPv4 Address in [Interface]")
if not peer_seen:
    raise SystemExit("ERROR: WireGuard config has no [Peer] section")
open(dst, "w", encoding="utf-8").write("\n".join(out) + "\n")
PY
}

wireguard_config_wizard(){
  local source_choice wg_src tmp line
  read -r -p "WireGuard interface name [${default_wg_if}]: " wireguard_if
  wireguard_if="${wireguard_if:-$default_wg_if}"
  validate_ifname "$wireguard_if"
  wireguard_conf="/etc/wireguard/${wireguard_if}.conf"

  source_choice="$(choose_number "WireGuard configuration source:" 1 \
    "Use existing ${wireguard_conf}" \
    "Paste WireGuard config now")"

  case "$source_choice" in
    1)
      [[ -f "$wireguard_conf" ]] || { echo "ERROR: not found: $wireguard_conf"; exit 1; }
      tmp="$(mktemp)"
      normalize_wireguard_config "$wireguard_conf" "$tmp"
      install -m 600 "$tmp" "$wireguard_conf"
      rm -f "$tmp"
      ;;
    2)
      mkdir -p /etc/wireguard
      tmp="$(mktemp)"
      cat <<'EOF'
Paste WireGuard config now.
Finish by typing END on a new line and pressing Enter.
EOF
      while IFS= read -r line; do
        [[ "$line" == "END" ]] && break
        printf '%s\n' "$line" >> "$tmp"
      done
      normalize_wireguard_config "$tmp" "$wireguard_conf"
      chmod 600 "$wireguard_conf"
      rm -f "$tmp"
      ;;
  esac

  echo "[wizard] WireGuard config prepared: $wireguard_conf"
  echo "[wizard] enforced IPv4-only Address, removed DNS lines, set Table = off, AllowedIPs = 0.0.0.0/0, and PersistentKeepalive = 25."
}

calc_peer_ip(){
  python3 - "$1" <<'PY'
import ipaddress, sys
n = ipaddress.ip_network(sys.argv[1], strict=False)
if n.version != 4 or n.prefixlen != 30:
    print("")
    raise SystemExit(0)
hosts = list(n.hosts())
cur = ipaddress.ip_interface(sys.argv[1]).ip
if cur not in hosts:
    print("")
    raise SystemExit(0)
peer = hosts[0] if hosts[1] == cur else hosts[1]
print(str(peer))
PY
}

default_gateway_for_iface(){
  local iface="$1"
  local gw
  gw="$(ip route show default dev "$iface" 2>/dev/null | awk '/default/ {for(i=1;i<=NF;i++) if($i=="via") print $(i+1)}' | head -n1)"
  if [[ -z "$gw" ]]; then
    gw="$(ip route show default 2>/dev/null | awk '/default/ {for(i=1;i<=NF;i++) if($i=="via") print $(i+1)}' | head -n1)"
  fi
  echo "$gw"
}


echo "=== V2rayTGE Config Wizard (Release: ${TGE_CLI_VERSION:-v1.0.0}) ==="

case "$default_egress_mode" in
  wireguard) default_egress_choice=2 ;;
  server_gateway) default_egress_choice=3 ;;
  *) default_egress_choice=1 ;;
esac
egress_choice="$(choose_number "Egress backend:" "$default_egress_choice" \
  "v2rayA system-tun (tun0)" \
  "WireGuard wg-quick (wg0)" \
  "Server default gateway (no tun/wg)")"
case "$egress_choice" in
  1) egress_mode="v2raya_tun"; tun_if="tun0"; wireguard_if="" ;;
  2) egress_mode="wireguard"; wireguard_config_wizard; tun_if="$wireguard_if" ;;
  3) egress_mode="server_gateway"; tun_if=""; wireguard_if="" ;;
esac

if [[ "$egress_mode" == "v2raya_tun" ]]; then
  tun0_precheck_or_guide
fi


# 4.1 NIC and edge-mode selection
guess_nic="$(guess_primary_nic)"
echo "Detected primary NIC: $guess_nic"
read -r -p "Confirm primary NIC for server (management + edge traffic) [${guess_nic}]: " nic
nic="${nic:-$guess_nic}"
validate_iface_exists "$nic"

local_ip="$(iface_ipv4 "$nic")"
echo "Local IPv4 on $nic: $local_ip"

server_gateway=""
server_gateway_if=""
if [[ "$egress_mode" == "server_gateway" ]]; then
  server_gateway_if="${default_server_gateway_if:-$nic}"
  guessed_server_gateway="${default_server_gateway:-$(default_gateway_for_iface "$server_gateway_if")}"
  if [[ -n "$guessed_server_gateway" ]]; then
    echo "[wizard] suggested server egress gateway: $guessed_server_gateway via $server_gateway_if"
  fi
  read -r -p "Server egress gateway IP [${guessed_server_gateway}]: " server_gateway
  server_gateway="${server_gateway:-$guessed_server_gateway}"
  validate_ipv4 "$server_gateway"
fi

case "$default_edge_mode" in
  direct) default_edge_choice=2 ;;
  *) default_edge_choice=1 ;;
esac
edge_choice="$(choose_number "Edge mode:" "$default_edge_choice" \
  "GRE tunnel" \
  "Direct primary NIC")"
case "$edge_choice" in
  1) edge_mode="gre" ;;
  2) edge_mode="direct" ;;
esac

gre_local_ip=""
gre_remote_ip=""
gre_tun_ip=""
gre_mtu=""
mss=""
direct_edge_gw=""

if [[ "$edge_mode" == "gre" ]]; then
  read -r -p "Confirm local GRE source IP [${local_ip}]: " gre_local_ip
  gre_local_ip="${gre_local_ip:-$local_ip}"
  validate_ipv4 "$gre_local_ip"

  # 4.2 remote GRE IP
  read -r -p "Confirm/Enter GRE remote IP (edge device IP) [${default_gre_remote_ip}]: " gre_remote_ip
  gre_remote_ip="${gre_remote_ip:-$default_gre_remote_ip}"
  validate_ipv4 "$gre_remote_ip"

  # 4.3 GRE tunnel IP + confirm
  while true; do
    read -r -p "Confirm/Enter GRE tunnel IP/CIDR for THIS server [${default_gre_tun_ip}]: " gre_tun_ip
    gre_tun_ip="${gre_tun_ip:-$default_gre_tun_ip}"
    if ! validate_cidr "$gre_tun_ip" >/dev/null 2>&1; then
      echo "ERROR: invalid CIDR: $gre_tun_ip"
      continue
    fi
    tun_subnet="$(cidr_network "$gre_tun_ip")"
    peer_ip="$(calc_peer_ip "$gre_tun_ip" || true)"
    echo "[wizard] tunnel subnet: $tun_subnet"
    if [[ -n "$peer_ip" ]]; then
      echo "[wizard] suggested edge tunnel IP: $peer_ip"
    else
      echo "[wizard] note: /30 is recommended for GRE point-to-point tunnel IPs."
    fi
    read -r -p "Confirm this GRE tunnel IP/CIDR? [Y/n]: " tun_confirm
    tun_confirm="${tun_confirm:-Y}"
    [[ "$tun_confirm" =~ ^[Yy]$ ]] && break
  done

  # GRE MTU
  read -r -p "Confirm/Enter GRE MTU [${default_gre_mtu}]: " gre_mtu
  gre_mtu="${gre_mtu:-$default_gre_mtu}"
  validate_int_range "$gre_mtu" 1200 9000
else
  guessed_direct_edge_gw="${default_direct_edge_gw:-$(default_gateway_for_iface "$nic")}"
  if [[ -n "$guessed_direct_edge_gw" ]]; then
    echo "[wizard] suggested direct next-hop from server default gateway: $guessed_direct_edge_gw"
  fi
  read -r -p "Forti/edge next-hop IP for LAN return routes [${guessed_direct_edge_gw}] (blank only if LANs are directly connected): " direct_edge_gw
  direct_edge_gw="${direct_edge_gw:-$guessed_direct_edge_gw}"
  if [[ -n "$direct_edge_gw" ]]; then
    validate_ipv4 "$direct_edge_gw"
  fi
fi

# 4.4 LAN CIDRs (multiple)
echo "Confirm/Enter LAN CIDRs behind edge device (multiple allowed). Default: $default_lan_cidr"
echo "Type 'done' when finished. Empty input is ignored."
lan_list=()
while true; do
  read -r -p "LAN CIDR (or 'done'): " c
  c="$(echo "$c" | xargs)"
  [[ -z "$c" ]] && continue
  [[ "$c" == "done" ]] && break
  validate_cidr "$c"
  lan_list+=("$c")
done

if [[ "${#lan_list[@]}" -eq 0 ]]; then
  lan_list=("$default_lan_cidr")
  echo "No LAN entered, using default: $default_lan_cidr"
fi

validate_no_overlap "${lan_list[@]}"

if [[ "$edge_mode" == "gre" ]]; then
  # 4.6 MSS clamp
  echo "MSS Clamp recommended: (GRE_MTU - 40). Example: 1476-40=1436"
  read -r -p "Confirm/Enter MSS clamp value [${default_mss}]: " mss
  mss="${mss:-$default_mss}"
  validate_int_range "$mss" 536 1460
fi

v2raya_port="$default_gui_port"
if [[ "$egress_mode" == "v2raya_tun" ]]; then
  # v2rayA UI port
  read -r -p "Confirm/Enter v2rayA GUI port [${default_gui_port}]: " v2raya_port
  v2raya_port="${v2raya_port:-$default_gui_port}"
  validate_int_range "$v2raya_port" 1 65535
fi

# Save config
cat > "$CFG" <<EOF
# V2rayTGE configuration
TGE_EGRESS_MODE="$egress_mode"
TGE_EDGE_MODE="$edge_mode"
PRIMARY_NIC="$nic"
DIRECT_EDGE_GW="$direct_edge_gw"
SERVER_GATEWAY="$server_gateway"
SERVER_GATEWAY_IF="$server_gateway_if"
WIREGUARD_IF="$wireguard_if"
GRE_IF="gre-egress"
GRE_LOCAL_IP="$gre_local_ip"
GRE_REMOTE_IP="$gre_remote_ip"
GRE_TUN_IP="$gre_tun_ip"
GRE_MTU="$gre_mtu"
LAN_CIDRS="$(join_by_comma "${lan_list[@]}")"
MSS_CLAMP="$mss"
V2RAY_TABLE="v2ray"
V2RAY_TABLE_ID="100"
TUN_IF="$tun_if"
V2RAYA_GUI_PORT="$v2raya_port"
EOF

chmod 600 "$CFG"
echo
echo "✅ Saved: $CFG"
echo

# Print edge-device instructions
echo "=== Edge Device (Remote) Requirements ==="
if [[ "$edge_mode" == "gre" ]]; then
  echo "- Create GRE tunnel:"
  echo "  Local IP (edge):    <edge device IP>"
  echo "  Remote IP (server): $gre_local_ip"
  echo "  Tunnel endpoints:   server=$gre_tun_ip  <-> edge=<choose complementary IP in same /30>"
  echo "  MTU:                $gre_mtu"
  echo
else
  echo "- Direct mode:"
  echo "  Send edge traffic directly to primary NIC: $nic (${local_ip:-no IPv4 detected})"
  if [[ -n "$direct_edge_gw" ]]; then
    echo "  TGE will route LAN return traffic via edge next-hop: $direct_edge_gw"
  else
    echo "  No edge next-hop configured; LAN CIDRs must be directly connected to $nic."
  fi
  echo "  No GRE tunnel, GRE MTU, or MSS clamp is configured in this mode."
  echo
fi
echo "- Policy Based Routing / Static route:"
if [[ "$edge_mode" == "gre" ]]; then
  echo "  Send LAN CIDRs via GRE tunnel interface:"
else
  echo "  Send LAN CIDRs toward the server primary NIC:"
fi
for c in "${lan_list[@]}"; do echo "   - $c"; done
echo
if [[ "$egress_mode" == "v2raya_tun" ]]; then
  echo "=== v2rayA GUI ==="
  echo "Open: http://$local_ip:$v2raya_port  (or server main IP)"
  echo "Configure outbound and enable system-tun transparent proxy."
  echo
  if ! ip link show tun0 >/dev/null 2>&1; then
    echo "NOTE: tun0 is not present yet. Apply will run automatically when tun0 appears (systemd path+timer)."
    echo "You can also run: sudo tge (Activate) after v2rayA is configured."
  else
    echo "tun0 is present. You can Activate now."
  fi
else
  if [[ "$egress_mode" == "server_gateway" ]]; then
    echo "=== Server Gateway Egress ==="
    echo "Traffic entering the selected edge interface will use: $server_gateway via $server_gateway_if"
    echo "No v2rayA/WireGuard egress tunnel is used in this mode."
    echo "TGE will MASQUERADE configured LAN CIDRs to the server IP before forwarding."
  else
    echo "=== WireGuard ==="
    echo "Interface: $wireguard_if"
    echo "Config: /etc/wireguard/${wireguard_if}.conf"
    echo "TGE will use $wireguard_if as the egress tunnel and will not start v2rayA in this mode."
  fi
fi

# 4.9 ask activate
read -r -p "Do you want to Activate now? [y/N]: " ans
if [[ "$ans" =~ ^[Yy]$ ]]; then
  /usr/local/sbin/tge-ctl --activate
  /usr/local/sbin/tge-health || true
fi
